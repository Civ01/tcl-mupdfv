# Trimmed MuPDF: PDF only, no XPS/HTML/EPUB/SVG/CBZ, no JavaScript, no colour
# management, no JPEG 2000, no appearance synthesis, Windows fonts instead of
# the bundled ones, and 4 of the 70 CJK CMaps. See mupdf-overrides/ and SPECS.md.
#
# Defines the static library target `mupdf_min`.

set(MU ${CMAKE_SOURCE_DIR}/extern/mupdf)
foreach(dir include thirdparty/freetype/include thirdparty/jbig2dec thirdparty/libjpeg thirdparty/zlib)
  if(NOT EXISTS ${MU}/${dir})
    message(FATAL_ERROR "extern/mupdf/${dir} is missing. Run:\n"
      "  git submodule update --init --depth 1 extern/mupdf\n"
      "  git -C extern/mupdf submodule update --init --depth 1 "
      "thirdparty/freetype thirdparty/jbig2dec thirdparty/libjpeg thirdparty/zlib")
  endif()
endforeach()

# Third-party source lists, taken from MuPDF's own Makelists.
file(STRINGS ${MU}/Makelists _makelists)
foreach(_lib FREETYPE JBIG2DEC LIBJPEG ZLIB)
  set(_${_lib}_SRC "")
endforeach()
foreach(_line IN LISTS _makelists)
  if(_line MATCHES "^(FREETYPE|JBIG2DEC|LIBJPEG|ZLIB)_SRC[ \t]*\\+=[ \t]*([^ \t#]+)")
    list(APPEND _${CMAKE_MATCH_1}_SRC ${MU}/${CMAKE_MATCH_2})
  endif()
endforeach()

# MuPDF itself: all of fitz and pdf, minus the files replaced in mupdf-overrides/.
file(GLOB _MUPDF_SRC ${MU}/source/fitz/*.c ${MU}/source/pdf/*.c)
foreach(_f
    fitz/load-jpx.c fitz/load-tiff.c fitz/load-bmp.c fitz/load-pnm.c  # tcl_stubs.c
    fitz/harfbuzz.c                                                   # text shaping for HTML only
    fitz/deskew.c fitz/skew.c                                         # scan deskewing, tools only
    pdf/pdf-appearance.c                                              # tcl_stubs.c
    pdf/pdf-cmap-load.c)                                              # tcl_cmap.c
  list(REMOVE_ITEM _MUPDF_SRC ${MU}/source/${_f})
endforeach()

# Built-in fonts we keep: ZapfDingbats and Symbol (Windows has no equivalent).
set(_fonts_c ${CMAKE_BINARY_DIR}/gen/tcl_builtin_fonts.c)
set(_fonts_text "/* Generated by cmake/mupdf.cmake from MuPDF's URW fonts. */\n")
foreach(_pair "tcl_font_dingbats|Dingbats.cff" "tcl_font_symbol|StandardSymbolsPS.cff")
  string(REPLACE "|" ";" _pair "${_pair}")
  list(GET _pair 0 _var)
  list(GET _pair 1 _file)
  file(READ ${MU}/resources/fonts/urw/${_file} _hex HEX)
  string(LENGTH "${_hex}" _len)
  math(EXPR _len "${_len} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _hex "${_hex}")
  string(REGEX REPLACE "((0x..,){24})" "\\1\n" _hex "${_hex}")
  string(APPEND _fonts_text "const unsigned char ${_var}[${_len}] = {\n${_hex}\n};\n"
                            "const int ${_var}_size = ${_len};\n")
endforeach()
file(CONFIGURE OUTPUT ${_fonts_c} CONTENT "${_fonts_text}" @ONLY)

add_library(mupdf_min STATIC
  ${_MUPDF_SRC}
  ${_FREETYPE_SRC} ${_JBIG2DEC_SRC} ${_LIBJPEG_SRC} ${_ZLIB_SRC}
  ${CMAKE_SOURCE_DIR}/mupdf-overrides/tcl_fonts.c
  ${CMAKE_SOURCE_DIR}/mupdf-overrides/tcl_cmap.c
  ${CMAKE_SOURCE_DIR}/mupdf-overrides/tcl_stubs.c
  ${_fonts_c})
set_target_properties(mupdf_min PROPERTIES LINKER_LANGUAGE C)

target_include_directories(mupdf_min
  PUBLIC ${MU}/include ${CMAKE_SOURCE_DIR}/mupdf-overrides
  PRIVATE ${MU}/source/fitz ${MU}/source/pdf
          ${MU}/thirdparty/freetype/include ${MU}/scripts/freetype
          ${MU}/thirdparty/libjpeg ${MU}/scripts/libjpeg
          ${MU}/thirdparty/jbig2dec ${MU}/thirdparty/zlib)

# Feature switches (include/mupdf/fitz/config.h). PUBLIC so the plugin sees the
# same configuration as the library.
target_compile_definitions(mupdf_min PUBLIC
  FZ_ENABLE_PDF=1 FZ_ENABLE_XPS=0 FZ_ENABLE_SVG=0 FZ_ENABLE_CBZ=0 FZ_ENABLE_IMG=0
  FZ_ENABLE_HTML=0 FZ_ENABLE_HTML_ENGINE=0 FZ_ENABLE_EPUB=0 FZ_ENABLE_FB2=0
  FZ_ENABLE_MOBI=0 FZ_ENABLE_OFFICE=0 FZ_ENABLE_TXT=0 FZ_ENABLE_MD=0
  FZ_ENABLE_JS=0 FZ_ENABLE_ICC=0 FZ_ENABLE_JPX=0 FZ_ENABLE_BROTLI=0
  FZ_ENABLE_BARCODE=0 FZ_ENABLE_HYPHEN=0
  FZ_ENABLE_OCR_OUTPUT=0 FZ_ENABLE_DOCX_OUTPUT=0 FZ_ENABLE_ODT_OUTPUT=0
  FZ_ENABLE_SPOT_RENDERING=0 FZ_PLOTTERS_CMYK=0
  TOFU TOFU_CJK TOFU_BASE14)
target_compile_definitions(mupdf_min PRIVATE
  FT2_BUILD_LIBRARY
  "FT_CONFIG_MODULES_H=\"slimftmodules.h\""
  "FT_CONFIG_OPTIONS_H=\"slimftoptions.h\""
  HAVE_STDINT_H "JBIG_EXTERNAL_MEMENTO_H=\"mupdf/memento.h\"")
# noto.c keeps the other font lookups (all empty with TOFU); the two standard
# font lookups are replaced by tcl_fonts.c.
set_source_files_properties(${MU}/source/fitz/noto.c PROPERTIES COMPILE_DEFINITIONS
  "fz_lookup_base14_font=tcl_unused_lookup_base14_font;fz_lookup_builtin_font=tcl_unused_lookup_builtin_font")

# Optimize for size, except the code that runs per pixel or per byte while
# rendering: the rasterizer, JPEG decoding, Flate decoding and glyph scaling.
file(GLOB _HOT_SRC ${MU}/source/fitz/draw-*.c ${MU}/source/fitz/filter-basic.c
     ${MU}/source/fitz/filter-flate.c ${MU}/source/fitz/filter-dct.c
     ${MU}/thirdparty/libjpeg/jidct*.c ${MU}/thirdparty/libjpeg/jdhuff.c
     ${MU}/thirdparty/libjpeg/jdcolor.c ${MU}/thirdparty/libjpeg/jdsample.c
     ${MU}/thirdparty/zlib/inflate.c ${MU}/thirdparty/zlib/inffast.c
     ${MU}/thirdparty/freetype/src/smooth/smooth.c)
if(MSVC)
  set(_size_opt /O1)
  set(_speed_opt /O2)
  string(REPLACE "/O2" "" CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE}")
  string(REPLACE "/O1" "" CMAKE_C_FLAGS_MINSIZEREL "${CMAKE_C_FLAGS_MINSIZEREL}")
else()
  set(_size_opt -Os)
  set(_speed_opt -O2)
  string(REPLACE "-O3" "" CMAKE_C_FLAGS_RELEASE "${CMAKE_C_FLAGS_RELEASE}")
  string(REPLACE "-Os" "" CMAKE_C_FLAGS_MINSIZEREL "${CMAKE_C_FLAGS_MINSIZEREL}")
endif()
target_compile_options(mupdf_min PRIVATE $<$<CONFIG:Release,MinSizeRel>:${_size_opt}>)
set_source_files_properties(${_HOT_SRC} PROPERTIES COMPILE_OPTIONS $<$<CONFIG:Release,MinSizeRel>:${_speed_opt}>)

if(MSVC)
  target_compile_definitions(mupdf_min PRIVATE _CRT_SECURE_NO_WARNINGS _CRT_NONSTDC_NO_WARNINGS)
  target_compile_options(mupdf_min PRIVATE /W0 /Gy /Gw)
else()
  target_compile_definitions(mupdf_min PRIVATE HAVE_UNISTD_H HAVE_STDARG_H)
  target_compile_options(mupdf_min PRIVATE -w -ffunction-sections -fdata-sections)
endif()
